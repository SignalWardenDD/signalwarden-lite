## 18) Псевдокод (ядро логики)

```python
ctx = build_context(symbol)
if regime(ctx).natr < ULTRA_CALM: return Skip("ultra_calm")
trend_ok = ema50(ctx) > ema200(ctx) if dir==LONG else ema50(ctx) < ema200(ctx)
if not trend_ok: return Skip("trend")
level = swing_level(ctx, lookback=20, dir)
entry = level + sign(dir) * atr(ctx)*atr_cushion(ctx.regime)
if not ltf_ok(ctx): return Skip("ltf_thin")
if position_context.blocks(dir): return Skip("context_block")
sl = entry - sign(dir)*atr(ctx)*1.5
partials = plan_partials([1.0,2.0,3.2],[0.15,0.25,0.60])
plan = OrderPlan(entry, sl, partials, ttl=8s, maker_first=True)
execute(plan)
```

